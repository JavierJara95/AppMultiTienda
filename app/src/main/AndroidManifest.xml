<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permite que MultiTienda solicite acceso a la cámara -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- La cámara es opcional porque también existe búsqueda manual -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppMultiTienda">

        <!-- Actividad principal del proyecto -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.AppMultiTienda"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Actividad temporal de pruebas de Esteban -->
        <activity
            android:name=".operador.ui.OperadorPaso1DemoActivity"
            android:exported="true"
            android:theme="@style/Theme.AppMultiTienda" />

    </application>

</manifest>

